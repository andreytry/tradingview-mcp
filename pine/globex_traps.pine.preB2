//@version=5
// GlobexTraps — Sweep-Reclaim v2
// Trap outside the pre-market (Globex) range, reclaimed into a Supply/Demand zone.
// Zone engine mirrors "Supply/Demand Zones with Zone Arrival/Departure Alerts" v5.
// B1.1 N/A: this strategy makes no D1/W request.security calls.
// B1.2: entry/alert gated on barstate.isconfirmed. B1.3: HTF via [1]+lookahead_on.
strategy("GlobexTraps", overlay=true, max_boxes_count=500, max_labels_count=500,
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=true, pyramiding=0,
     commission_type=strategy.commission.cash_per_order, commission_value=0.5,
     slippage=1)

// ─────────── Inputs ───────────
grpS = "Session (New York time)"
pmSess = input.session("0400-0930", "Pre-market range", group=grpS)
trSess = input.session("0930-1130", "Trade window", group=grpS)
TZ = "America/New_York"

grpZ = "Zone detection"
useCT  = input.bool(true, "CT zones", group=grpZ)
use15  = input.bool(true, "15M zones", group=grpZ)
use60  = input.bool(true, "60M zones", group=grpZ)
atrLen     = input.int(14, "ATR length", group=grpZ)
legOutAtr  = input.float(0.5, "Leg-out min body (x ATR)", step=0.05, group=grpZ)
maxLSRatio = input.float(0.5, "Max base body / leg-out body", step=0.05, group=grpZ)
legRatio   = input.float(0.25, "Leg-in min body / leg-out body", step=0.05, group=grpZ)
maxSmall   = input.int(10, "Max base candles", group=grpZ)
maxWick    = input.float(10.0, "Max wick / body", step=0.5, group=grpZ)
breachPct  = input.float(0.25, "Breach (x zone height)", step=0.05, group=grpZ)
maxZones   = input.int(200, "Max active zones", group=grpZ)

grpT = "Trade rules"
newsAtr    = input.float(2.5, "Skip sweep if bar range >= x ATR", step=0.1, group=grpT)
reclaimMax = input.int(3, "Reclaim within N bars", group=grpT)
stopAtrBuf = input.float(0.25, "Stop buffer beyond wick (x ATR)", step=0.05, group=grpT)
maxRiskAtr = input.float(1.0, "Skip if risk > x ATR", step=0.05, group=grpT)
targetR    = input.float(1.0, "Target (R)", step=0.1, group=grpT)
minTicks   = input.int(16, "Min stop distance (ticks)", group=grpT)
drawZones  = input.bool(false, "Draw active zones", group=grpT)

// ─────────── Zone store ───────────
type Zone
    float top
    float bot
    bool  dem
    int   tf
    int   born

var array<Zone> zones = array.new<Zone>()

pushHist(array<float> a, float v) =>
    array.unshift(a, v)
    if array.size(a) > 120
        array.pop(a)

detect(array<float> oh, array<float> hh, array<float> lh, array<float> ch, array<float> ah, int tfId) =>
    if array.size(oh) >= maxSmall + 2
        float curO = array.get(oh, 0)
        float curC = array.get(ch, 0)
        float curA = array.get(ah, 0)
        if not na(curO) and not na(curC) and not na(curA) and curA > 0 and curO != curC
            float curBody = math.abs(curC - curO)
            if curBody >= curA * legOutAtr
                bool curGreen = curC > curO
                int small = 0
                int idx = 1
                bool valid = false
                int legIn = -1
                while idx <= maxSmall and idx < array.size(oh)
                    float sO = array.get(oh, idx)
                    float sC = array.get(ch, idx)
                    if na(sO) or na(sC)
                        break
                    float sBody = math.abs(sC - sO)
                    if small >= 1 and sBody >= curBody * legRatio
                        valid := true
                        legIn := idx
                        break
                    float sH = array.get(hh, idx)
                    float sL = array.get(lh, idx)
                    if na(sH) or na(sL)
                        break
                    float upW = sH - math.max(sO, sC)
                    float dnW = math.min(sO, sC) - sL
                    float mxW = math.max(upW, dnW)
                    if sBody > 0 and mxW <= sBody * maxWick and sBody <= curBody * maxLSRatio
                        small += 1
                        idx += 1
                    else
                        break
                if not valid and small >= 1
                    legIn := math.min(idx, array.size(oh) - 1)
                    valid := true
                if valid and legIn > 0 and small >= 1
                    float lO = array.get(oh, legIn)
                    float lC = array.get(ch, legIn)
                    if not na(lO) and not na(lC) and lO != lC
                        float ztop = na
                        float zbot = na
                        if curGreen
                            ztop := math.max(array.get(oh, 1), array.get(ch, 1))
                            zbot := array.get(lh, 0)
                            for i = 1 to small
                                if i < array.size(oh)
                                    ztop := math.max(ztop, math.max(array.get(oh, i), array.get(ch, i)))
                                    zbot := math.min(zbot, array.get(lh, i))
                        else
                            ztop := array.get(hh, 0)
                            zbot := math.min(array.get(oh, 1), array.get(ch, 1))
                            for i = 1 to small
                                if i < array.size(oh)
                                    ztop := math.max(ztop, array.get(hh, i))
                                    zbot := math.min(zbot, math.min(array.get(oh, i), array.get(ch, i)))
                        if not na(ztop) and not na(zbot) and ztop > zbot
                            array.unshift(zones, Zone.new(ztop, zbot, curGreen, tfId, bar_index))
                            if array.size(zones) > maxZones
                                array.pop(zones)

// ─────────── Per-timeframe history ───────────
var array<float> oCT = array.new_float(), var array<float> hCT = array.new_float()
var array<float> lCT = array.new_float(), var array<float> cCT = array.new_float()
var array<float> aCT = array.new_float()
var array<float> o15 = array.new_float(), var array<float> h15 = array.new_float()
var array<float> l15 = array.new_float(), var array<float> c15 = array.new_float()
var array<float> a15 = array.new_float()
var array<float> o60 = array.new_float(), var array<float> h60 = array.new_float()
var array<float> l60 = array.new_float(), var array<float> c60 = array.new_float()
var array<float> a60 = array.new_float()

atrCT = ta.atr(atrLen)
[O15, H15, L15, C15, A15] = request.security(syminfo.tickerid, "15", [open[1], high[1], low[1], close[1], ta.atr(atrLen)[1]], lookahead=barmerge.lookahead_on)
[O60, H60, L60, C60, A60] = request.security(syminfo.tickerid, "60", [open[1], high[1], low[1], close[1], ta.atr(atrLen)[1]], lookahead=barmerge.lookahead_on)
new15 = ta.change(time("15")) != 0
new60 = ta.change(time("60")) != 0

if useCT and not na(open[1])
    pushHist(oCT, open[1]), pushHist(hCT, high[1]), pushHist(lCT, low[1])
    pushHist(cCT, close[1]), pushHist(aCT, atrCT[1])
    detect(oCT, hCT, lCT, cCT, aCT, 0)
if use15 and new15 and not na(O15)
    pushHist(o15, O15), pushHist(h15, H15), pushHist(l15, L15)
    pushHist(c15, C15), pushHist(a15, A15)
    detect(o15, h15, l15, c15, a15, 1)
if use60 and new60 and not na(O60)
    pushHist(o60, O60), pushHist(h60, H60), pushHist(l60, L60)
    pushHist(c60, C60), pushHist(a60, A60)
    detect(o60, h60, l60, c60, a60, 2)

// ─────────── Breach removal + same-TF overlap cull ───────────
if array.size(zones) > 0
    int i = array.size(zones) - 1
    while i >= 0
        Zone z = array.get(zones, i)
        float amt = (z.top - z.bot) * breachPct
        if (z.dem ? low < z.bot - amt : high > z.top + amt)
            array.remove(zones, i)
        i -= 1

if array.size(zones) > 1
    int i = 0
    while i < array.size(zones)
        Zone zi = array.get(zones, i)
        int j = i + 1
        bool removedI = false
        while j < array.size(zones)
            Zone zj = array.get(zones, j)
            if zi.tf == zj.tf and not (zi.bot > zj.top or zj.bot > zi.top)
                if zi.born <= zj.born
                    array.remove(zones, j)
                else
                    array.remove(zones, i)
                    removedI := true
                    break
            else
                j += 1
        if not removedI
            i += 1

findZone(float px, bool wantDem) =>
    float zt = na
    float zb = na
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if z.dem == wantDem and px >= z.bot and px <= z.top
                zt := z.top
                zb := z.bot
                break
    [zt, zb]

// ─────────── Pre-market range ───────────
bool inPM = not na(time(timeframe.period, pmSess, TZ))
bool inTR = not na(time(timeframe.period, trSess, TZ))
var float pmH = na
var float pmL = na
var int pmBars = 0
if inPM and not inPM[1]
    pmH := high
    pmL := low
    pmBars := 1
else if inPM
    pmH := math.max(pmH, high)
    pmL := math.min(pmL, low)
    pmBars += 1

// ─────────── Sweep → reclaim state machine ───────────
var int   swDir  = 0
var float swWick = na
var float swZT   = na
var float swZB   = na
var float swAtr  = na
var int   swBar  = na

// 1) reclaim check first, so the sweep bar itself cannot be its own reclaim
// B1.2: confirmed bars only - never act on an unconfirmed bar.
if barstate.isconfirmed and swDir != 0
    if bar_index - swBar > reclaimMax
        swDir := 0
    else
        bool inZone = close >= swZB and close <= swZT
        bool backIn = swDir == 1 ? close > pmL : close < pmH
        if inZone and backIn
            float raw = swDir == 1 ? swWick - (syminfo.mintick + stopAtrBuf * swAtr) : swWick + (syminfo.mintick + stopAtrBuf * swAtr)
            float stopPx = math.round(raw / syminfo.mintick) * syminfo.mintick
            float R = math.abs(close - stopPx)
            if R <= maxRiskAtr * swAtr and R >= minTicks * syminfo.mintick and strategy.position_size == 0
                float tgt = swDir == 1 ? close + targetR * R : close - targetR * R
                if swDir == 1
                    strategy.entry("GT-L", strategy.long)
                    strategy.exit("GT-L x", "GT-L", stop=stopPx, limit=tgt)
                else
                    strategy.entry("GT-S", strategy.short)
                    strategy.exit("GT-S x", "GT-S", stop=stopPx, limit=tgt)
                label.new(bar_index, swDir == 1 ? low : high,
                     (swDir == 1 ? "TRAP L " : "TRAP S ") + str.tostring(close, format.mintick),
                     style=swDir == 1 ? label.style_label_up : label.style_label_down,
                     color=swDir == 1 ? color.new(color.teal, 20) : color.new(color.red, 20),
                     textcolor=color.white, size=size.tiny)
            swDir := 0

// 2) sweep detection
bool haveRange = not na(pmH) and not na(pmL) and pmBars >= 6
if barstate.isconfirmed and inTR and haveRange and swDir == 0 and not na(atrCT)
    bool above = high > pmH
    bool below = low < pmL
    bool fresh = above ? not (high[1] > pmH) : below ? not (low[1] < pmL) : false
    bool quiet = (high - low) < newsAtr * atrCT
    if (above or below) and fresh and quiet
        float wick = above ? high : low
        [zt, zb] = findZone(wick, not above)
        if not na(zt)
            swDir  := above ? -1 : 1
            swWick := wick
            swZT   := zt
            swZB   := zb
            swAtr  := atrCT
            swBar  := bar_index

// ─────────── Plots ───────────
plot(inTR and haveRange ? pmH : na, "PM high", color.new(color.red, 0), 1, plot.style_linebr)
plot(inTR and haveRange ? pmL : na, "PM low", color.new(color.lime, 0), 1, plot.style_linebr)
plot(inTR and haveRange ? (pmH + pmL) / 2 : na, "PM mid", color.new(color.gray, 40), 1, plot.style_linebr)
bgcolor(inTR ? color.new(color.blue, 94) : na, title="Trade window")
plotshape(swDir != 0 and swDir[1] == 0, "Sweep", shape.triangleup, location.belowbar, color.new(color.orange, 0), size=size.tiny)
