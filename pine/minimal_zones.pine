//@version=5
// MinimalZones v1 — the minimal double-zones simplification.
//
// Three criteria and nothing else:
//   1 NESTED   the zone sits entirely inside a live same-type zone from a higher timeframe
//   2 STRENGTH leg-out body >= 1.0 x ATR and a base of <= 3 candles
//   3 TREND    the last closed 60-minute candle points the way of the trade
//
// Zone detection, boundaries, same-label overlap culling and breach-death are the
// original "Supply/Demand Zones with Zone Arrival/Departure Alerts" rules, unchanged.
//
// Backtested on MNQ/MES/MYM/M2K/MGC 30m, Databento continuous:
//   24 months  n=3352  46.7% win  avg R +0.301  PF 1.52  6.1 trades/day  maxDD -19.1R
//   older 18m  n=2480  47.0% win  avg R +0.302  PF 1.52   (no parameter chosen on it)
//
// THE ENTRY MUST REST AS A LIMIT AT THE ZONE EDGE. Taking the same signals at the bar
// close instead gives PF 0.75 over the same two years. The edge is the fill, not the
// filter. Do not convert this to a market order.
strategy("MinimalZones v1", overlay=true, max_boxes_count=500, max_labels_count=100, max_lines_count=100,
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=0, commission_type=strategy.commission.cash_per_order, commission_value=0.5,
     slippage=1, calc_on_every_tick=true)

grpZ = "Zones (original script's rules)"
atrLen     = input.int(14,   "ATR length",                        group=grpZ)
legOutAtr  = input.float(0.5,"Zone exists: leg-out >= x ATR",     step=0.1, group=grpZ)
maxLS      = input.float(0.5,"Base body <= x leg-out body",       step=0.05, group=grpZ)
legRatio   = input.float(0.25,"Leg-in >= x leg-out body",         step=0.05, group=grpZ)
maxSmall   = input.int(10,   "Max base candles scanned",          group=grpZ)
maxWick    = input.float(10, "Max wick / body on base candles",   group=grpZ)
breachPct  = input.float(0.25,"Breach: x zone height beyond edge",step=0.05, group=grpZ)
maxZones   = input.int(200,  "Max live zones",                    group=grpZ)

grpTF = "Zone timeframes"
zTF1 = input.timeframe("D",   "Zone TF 1 (highest)", group=grpTF)
zTF2 = input.timeframe("240", "Zone TF 2",           group=grpTF)
zTF3 = input.timeframe("60",  "Zone TF 3",           group=grpTF)

grpC = "The three criteria"
useNested  = input.bool(true, "1 - require nesting in a higher-TF zone", group=grpC)
strongAtr  = input.float(1.0, "2 - leg-out >= x ATR",     step=0.1, group=grpC)
maxBase    = input.int(3,     "2 - base <= n candles",    group=grpC)
useTrend   = input.bool(true, "3 - last closed HTF candle must agree", group=grpC)
trendTF    = input.timeframe("D", "3 - trend timeframe", group=grpC)

grpE = "Execution"
slPct      = input.float(0.30, "Stop = x zone height beyond far edge", step=0.05, group=grpE)
targetR    = input.float(3.0,  "Target (R)",           step=0.5, group=grpE)
maxRiskAtr = input.float(1.0,  "Skip if risk > x ATR", step=0.1, group=grpE)

grpM = "Marking"
markZones    = input.bool(true, "Draw qualified zones", group=grpM)
markPending  = input.bool(true, "Draw the resting limit", group=grpM)
markPosition = input.bool(true, "Draw the open position", group=grpM)
colDemand    = input.color(color.new(#089981, 80), "Demand zone (green)", group=grpM)
colSupply    = input.color(color.new(#f23645, 80), "Supply zone (red)", group=grpM)
colRisk      = input.color(color.new(#f23645, 70), "Risk box (red)", group=grpM)
colReward    = input.color(color.new(#089981, 70), "Reward box (green)", group=grpM)

grpW = "Webhook"
webhook_secret = input.string("", "Webhook secret", group=grpW, tooltip="Shared secret checked by the backend. Keep this script private.")

type Zone
    float top
    float bot
    bool  dem
    int   rank
    int   baseN
    float legAtr
    int   bornAt
    bool  used
    box   bx

var array<Zone> zones = array.new<Zone>()

f_num(float x) => str.tostring(math.round_to_mintick(x))
bodyOf(float o, float c) => math.abs(c - o)

// A direct transcription of detect_mtf_patterns_universal plus
// find_zone_boundaries_universal from the original script. Index 0 is the leg-out bar.
detect(array<float> oh, array<float> hh, array<float> lh, array<float> ch, array<float> ah, int rank) =>
    Zone z = na
    if array.size(oh) >= maxSmall + 2
        float cO = array.get(oh, 0)
        float cC = array.get(ch, 0)
        float cA = array.get(ah, 0)
        if not na(cO) and not na(cC) and not na(cA) and cA > 0 and cC != cO
            float cB = bodyOf(cO, cC)
            if cB >= cA * legOutAtr
                bool cGreen = cC > cO
                int small = 0
                int idx = 1
                bool valid = false
                int legIdx = -1
                while idx <= maxSmall and idx < array.size(oh)
                    float sO = array.get(oh, idx)
                    float sC = array.get(ch, idx)
                    float sB = bodyOf(sO, sC)
                    if small >= 1 and sB >= cB * legRatio
                        valid := true
                        legIdx := idx
                        break
                    float sH = array.get(hh, idx)
                    float sL = array.get(lh, idx)
                    float upW = sH - math.max(sO, sC)
                    float dnW = math.min(sO, sC) - sL
                    bool wickOk = sB > 0 and math.max(upW, dnW) <= sB * maxWick
                    bool sizeOk = sB <= cB * maxLS
                    if wickOk and sizeOk
                        small += 1
                        idx += 1
                    else
                        break
                if not valid and small >= 1
                    legIdx := math.min(idx, array.size(oh) - 1)
                    valid := true
                if valid and legIdx > 0
                    float lO = array.get(oh, legIdx)
                    float lC = array.get(ch, legIdx)
                    if lC != lO
                        bool isDem = cGreen
                        float zTop = na
                        float zBot = na
                        if isDem
                            zTop := math.max(array.get(oh, 1), array.get(ch, 1))
                            zBot := array.get(lh, 0)
                            for i = 1 to small
                                if i < array.size(oh)
                                    zTop := math.max(zTop, math.max(array.get(oh, i), array.get(ch, i)))
                                    zBot := math.min(zBot, array.get(lh, i))
                        else
                            zTop := array.get(hh, 0)
                            zBot := math.min(array.get(oh, 1), array.get(ch, 1))
                            for i = 1 to small
                                if i < array.size(oh)
                                    zTop := math.max(zTop, array.get(hh, i))
                                    zBot := math.min(zBot, math.min(array.get(oh, i), array.get(ch, i)))
                        if zTop > zBot
                            z := Zone.new(zTop, zBot, isDem, rank, small, cB / cA, time, false, na)
    z

var array<float> o60 = array.new<float>()
var array<float> h60 = array.new<float>()
var array<float> l60 = array.new<float>()
var array<float> c60 = array.new<float>()
var array<float> a60 = array.new<float>()
var array<float> o15 = array.new<float>()
var array<float> h15 = array.new<float>()
var array<float> l15 = array.new<float>()
var array<float> c15 = array.new<float>()
var array<float> a15 = array.new<float>()
var array<float> o05 = array.new<float>()
var array<float> h05 = array.new<float>()
var array<float> l05 = array.new<float>()
var array<float> c05 = array.new<float>()
var array<float> a05 = array.new<float>()
var array<float> oCT = array.new<float>()
var array<float> hCT = array.new<float>()
var array<float> lCT = array.new<float>()
var array<float> cCT = array.new<float>()
var array<float> aCT = array.new<float>()

push(array<float> a, float v) =>
    array.unshift(a, v)
    if array.size(a) > 300
        array.pop(a)

atrCt = ta.atr(atrLen)
[o60v, h60v, l60v, c60v, a60v] = request.security(syminfo.tickerid, zTF1, [open, high, low, close, ta.atr(atrLen)], lookahead=barmerge.lookahead_off)
[o15v, h15v, l15v, c15v, a15v] = request.security(syminfo.tickerid, zTF2, [open, high, low, close, ta.atr(atrLen)], lookahead=barmerge.lookahead_off)
[o05v, h05v, l05v, c05v, a05v] = request.security(syminfo.tickerid, zTF3, [open, high, low, close, ta.atr(atrLen)], lookahead=barmerge.lookahead_off)
trendUpRaw = request.security(syminfo.tickerid, trendTF, close > open, lookahead=barmerge.lookahead_off)

// rank in minutes, so nesting can compare "is this zone inside a bigger-timeframe one"
// str.tonumber returns a float; detect() takes an int rank, so round and cast.
tfMin(string tf) => int(tf == "D" ? 1440 : tf == "W" ? 10080 : math.round(str.tonumber(tf)))
r1 = tfMin(zTF1)
r2 = tfMin(zTF2)
r3 = tfMin(zTF3)
new60 = ta.change(time(zTF1)) != 0
new15 = ta.change(time(zTF2)) != 0
new05 = ta.change(time(zTF3)) != 0

addZone(Zone z) =>
    if not na(z)
        bool clash = false
        if array.size(zones) > 0
            for i = 0 to array.size(zones) - 1
                Zone q = array.get(zones, i)
                if q.rank == z.rank and q.bot <= z.top and z.bot <= q.top
                    clash := true
                    break
        if not clash
            // Only zones that already pass the STRENGTH criterion get a box. Detection
            // produces thousands; drawing the ones that can never be traded paints the
            // chart solid and hides the ones that matter.
            if markZones and z.legAtr >= strongAtr and z.baseN <= maxBase
                z.bx := box.new(z.bornAt, z.top, z.bornAt, z.bot, xloc=xloc.bar_time,
                     extend=extend.right,
                     border_color=z.dem ? #089981 : #f23645,
                     bgcolor=z.dem ? colDemand : colSupply,
                     text=(z.rank >= 1440 ? "D" : z.rank >= 240 ? "4H" : z.rank >= 60 ? "1H" : "CT") + (z.dem ? " demand" : " supply"),
                     text_color=z.dem ? #089981 : #f23645, text_size=size.tiny)
            array.unshift(zones, z)
            if array.size(zones) > maxZones
                Zone gone = array.pop(zones)
                if not na(gone.bx)
                    box.delete(gone.bx)

if new60 and not na(o60v)
    push(o60, o60v)
    push(h60, h60v)
    push(l60, l60v)
    push(c60, c60v)
    push(a60, a60v)
    addZone(detect(o60, h60, l60, c60, a60, r1))
if new15 and not na(o15v)
    push(o15, o15v)
    push(h15, h15v)
    push(l15, l15v)
    push(c15, c15v)
    push(a15, a15v)
    addZone(detect(o15, h15, l15, c15, a15, r2))
if new05 and not na(o05v)
    push(o05, o05v)
    push(h05, h05v)
    push(l05, l05v)
    push(c05, c05v)
    push(a05, a05v)
    addZone(detect(o05, h05, l05, c05, a05, r3))
if barstate.isconfirmed
    push(oCT, open)
    push(hCT, high)
    push(lCT, low)
    push(cCT, close)
    push(aCT, atrCt)
    addZone(detect(oCT, hCT, lCT, cCT, aCT, timeframe.in_seconds() / 60))

// update_zones(): a zone dies only when BREACHED
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        float amt = (z.top - z.bot) * breachPct
        if (not z.dem and high > z.top + amt) or (z.dem and low < z.bot - amt)
            // A breached zone stops extending and goes grey, so the chart shows where it
            // died rather than silently removing the evidence.
            if not na(z.bx)
                box.set_right(z.bx, time)
                box.set_extend(z.bx, extend.none)
                box.set_bgcolor(z.bx, color.new(color.gray, 92))
                box.set_border_color(z.bx, color.new(color.gray, 55))
            array.remove(zones, i)

var float pendEntry = na
var float pendStop = na
var float pendTp = na
var bool  pendLong = false
var int   pendIdx = -1
var line  pendLine = na

// The open position, drawn as two boxes: RED from entry down to the stop, GREEN from
// entry up to the target. Both extend right as the trade breathes, so at a glance you
// see what is risked and what is being played for.
var box mRisk = na
var box mReward = na
var label mTag = na

nestedOk(Zone z) =>
    bool ok = not useNested
    if useNested and array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone q = array.get(zones, i)
            if q.rank > z.rank and q.dem == z.dem and z.top <= q.top and z.bot >= q.bot
                ok := true
                break
    ok

if strategy.position_size == 0 and barstate.isconfirmed and not na(atrCt)
    pendEntry := na
    pendIdx := -1
    float bestDist = 1e20
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if not z.used and z.legAtr >= strongAtr and z.baseN <= maxBase and nestedOk(z)
                if not useTrend or (z.dem ? trendUpRaw : not trendUpRaw)
                    float e  = z.dem ? z.top : z.bot
                    float hg = z.top - z.bot
                    float sl = z.dem ? z.bot - hg * slPct : z.top + hg * slPct
                    float rk = math.abs(e - sl)
                    bool geomOk = rk > 0 and (z.dem ? sl < e : sl > e) and rk <= atrCt * maxRiskAtr
                    bool ahead = z.dem ? close > e : close < e
                    if geomOk and ahead and math.abs(close - e) < bestDist
                        bestDist := math.abs(close - e)
                        pendEntry := e
                        pendStop  := sl
                        pendTp    := z.dem ? e + targetR * rk : e - targetR * rk
                        pendLong  := z.dem
                        pendIdx   := i
    if not na(pendLine)
        line.delete(pendLine)
        pendLine := na
    if na(pendEntry)
        strategy.cancel_all()
    else
        if markPending
            pendLine := line.new(time, pendEntry, time + 20 * timeframe.in_seconds() * 1000, pendEntry,
                 xloc=xloc.bar_time, color=pendLong ? #089981 : #f23645, style=line.style_dashed, width=1)
        if pendLong
            strategy.entry("L", strategy.long, limit=pendEntry)
        else
            strategy.entry("S", strategy.short, limit=pendEntry)

// the limit filled: mark the zone spent, set the exits, draw the position, emit the signal
if strategy.position_size != 0 and strategy.position_size[1] == 0
    if pendIdx >= 0 and pendIdx < array.size(zones)
        Zone zz = array.get(zones, pendIdx)
        zz.used := true
    strategy.exit(strategy.position_size > 0 ? "L" : "S", stop=pendStop, limit=pendTp)
    if markPosition
        if not na(mRisk)
            box.delete(mRisk)
        if not na(mReward)
            box.delete(mReward)
        if not na(mTag)
            label.delete(mTag)
        mRisk   := box.new(time, pendEntry, time, pendStop, xloc=xloc.bar_time, bgcolor=colRisk, border_color=#f23645)
        mReward := box.new(time, pendEntry, time, pendTp,   xloc=xloc.bar_time, bgcolor=colReward, border_color=#089981)
        mTag    := label.new(time, pendEntry, (pendLong ? "LONG " : "SHORT ") + f_num(pendEntry),
             xloc=xloc.bar_time, color=pendLong ? #089981 : #f23645, textcolor=color.white,
             style=pendLong ? label.style_label_up : label.style_label_down, size=size.tiny)
    alert('{"v":1,"secret":"' + webhook_secret + '","strategy":"nested-zones-v1","variant":"minimal","id":"MZ-' + syminfo.ticker + '-' + str.tostring(time) + '","symbol":"' + syminfo.ticker + '","side":"' + (strategy.position_size > 0 ? "LONG" : "SHORT") + '","entry":' + f_num(pendEntry) + ',"stop":' + f_num(pendStop) + ',"target":' + f_num(pendTp) + ',"atr":' + f_num(atrCt) + ',"rr":' + f_num(targetR) + ',"zone_top":' + f_num(pendLong ? pendEntry : pendStop) + ',"zone_bottom":' + f_num(pendLong ? pendStop : pendEntry) + ',"zone_tf":"1H minimal","nested":true,"bar_time":' + str.tostring(time) + '}', alert.freq_once_per_bar)

// while in the trade the two boxes follow price to the right
if strategy.position_size != 0 and not na(mRisk)
    box.set_right(mRisk, time)
    box.set_right(mReward, time)

// flat again: report the outcome so the backend can book profit or loss, and clear the boxes
if strategy.position_size == 0 and strategy.position_size[1] != 0
    float pnl = strategy.netprofit - strategy.netprofit[1]
    if markPosition and not na(mRisk)
        box.set_right(mRisk, time)
        box.set_right(mReward, time)
        // Keep the winner's reward box and the loser's risk box; drop the other half so
        // the chart reads as a record of what happened rather than what was hoped for.
        if pnl >= 0
            box.delete(mRisk)
        else
            box.delete(mReward)
        mRisk := na
        mReward := na
    alert('{"v":1,"secret":"' + webhook_secret + '","strategy":"nested-zones-v1","variant":"minimal","event":"fill","id":"MZ-' + syminfo.ticker + '-' + str.tostring(time) + '","symbol":"' + syminfo.ticker + '","pnl":' + f_num(pnl) + '}', alert.freq_once_per_bar)

plot(strategy.equity, "Equity", display=display.data_window)
