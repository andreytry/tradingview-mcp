//@version=5
// STRATEGY B - TREND CONTINUATION
//
// Follow the established move. Supply/demand zones are built independently on 5m, 15m,
// 1h and 4h. A zone survives only if at least 3 of those 4 hold an overlapping,
// same-direction zone at the same price, the other timeframe's zone confirmed first.
//
// Sequence, all on the 15m chart: price retraces into a qualifying zone, RSI is not
// overextended, a rejection candle prints, enter at its close. No break, no retest -
// that is Strategy A's job, and it is what stops the two colliding on one zone.
strategy("Strategy B - Trend Continuation", overlay=true,
     max_boxes_count=500, max_labels_count=500, max_lines_count=100,
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     pyramiding=0, commission_type=strategy.commission.cash_per_order, commission_value=0.5,
     slippage=1, calc_on_every_tick=false,
     // The stop and target are computed from THIS bar's close, so the fill has to happen
     // at this bar's close too. Without this, strategy.entry is a market order that fills
     // at the NEXT bar's open, and the risk geometry is measured from a different bar
     // than the one actually entered.
     process_orders_on_close=true,
     // Explicit rather than implied. No extra intrabar recalculation after a fill.
     calc_on_order_fills=false)
// NOTE: use_bar_magnifier=true would resolve fills on 1-minute bars and remove the
// stop-first assumption on a bar that spans both levels. It requires a Premium plan;
// this account is on Essential and TradingView refuses to compute the report with it on.

grpZ = "Zone construction"
atrLen    = input.int(14,   "ATR length", group=grpZ)
legAtr    = input.float(1.5,"Leg-out body >= x ATR", step=0.1, group=grpZ)
baseMax   = input.int(3,    "Max base candles", group=grpZ)
baseRatio = input.float(0.5,"Base body <= x next body", step=0.05, group=grpZ)
swingLR   = input.int(2,    "Swing pivot left/right", group=grpZ)
maxZones  = input.int(2000,  "Max live zones per timeframe", group=grpZ)

grpC = "Confluence"
needTF    = input.int(1, "Timeframes that must agree (of 4)", minval=1, maxval=4, group=grpC)
tfA       = input.timeframe("5",   "Zone TF 1", group=grpC)
tfC       = input.timeframe("60",  "Zone TF 3", group=grpC)
tfD       = input.timeframe("240", "Zone TF 4", group=grpC)

grpT = "Trend and entry"
trendTF   = input.timeframe("60", "Trend timeframe", group=grpT)
trendLeg  = input.int(3, "Consecutive HH+HL / LL+LH", group=grpT)
rsiLen    = input.int(14, "RSI length", group=grpT)
trendWhen = input.string("touch", "Trend sampled at", options=["touch", "zone birth"], group=grpT)
rsiLongMax  = input.float(100, "Long: RSI below", group=grpT)
rsiShortMin = input.float(0, "Short: RSI above", group=grpT)

grpE = "Execution"
slPct     = input.float(0.30, "Stop = x zone width beyond distal", step=0.05, group=grpE)
targetR   = input.float(3.0,  "Target (R)", step=0.5, group=grpE)
noRoll    = input.bool(true,  "Skip contract-roll days", group=grpE)
drawZones = input.bool(true,  "Draw traded zones", group=grpE)

grpR = "Relaxations"
useFVG    = input.bool(true,  "Require 3-bar imbalance", group=grpR)
useBOS    = input.bool(true,  "Require break of structure", group=grpR)
trendMode = input.string("off", "Trend definition", options=["hh_hl", "htf_candle", "off"], group=grpR)

// ─────────── zone ───────────
type Zone
    float top
    float bot
    bool  dem
    int   born      // bar_index of the chart bar on which the zone was registered
    bool  used
    int   tdir      // 1h trend as it stood when the zone was registered
    int   conf      // confluence count, resolved once when the zone was registered

var array<Zone> zA = array.new<Zone>()
var array<Zone> zB = array.new<Zone>()
var array<Zone> zC = array.new<Zone>()
var array<Zone> zD = array.new<Zone>()

bodyOf(float o, float c) => math.abs(c - o)

// ─────────── detection, evaluated inside each timeframe's own context ───────────
detect() =>
    float a  = ta.atr(atrLen)
    float ph = ta.pivothigh(high, swingLR, swingLR)
    float pl = ta.pivotlow(low, swingLR, swingLR)
    var float lastPH = na
    var float lastPL = na
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl

    float lo   = bodyOf(open, close)
    bool  bull = close > open
    float zt = na
    float zb = na
    bool  dem = false
    bool  ok  = false

    if not na(a) and a > 0 and lo >= legAtr * a and close != open
        // base: up to baseMax candles, each body <= baseRatio x the body that follows it
        // each base candle is measured against the LEG-OUT body, not the candle after it.
        // Chaining it makes candle 2 need <=25% and candle 3 <=12.5%, which all but
        // removes multi-candle bases and builds zones that are far too narrow.
        int n = 0
        while n < baseMax and bodyOf(open[1 + n], close[1 + n]) <= lo * baseRatio
            n += 1
        if n >= 1
            bool bos = not useBOS or (bull ? (not na(lastPH) and close > lastPH) : (not na(lastPL) and close < lastPL))
            bool fvg = not useFVG or (bull ? (high[2] < low) : (low[2] > high))
            if bos and fvg
                float t = high[1]
                float b = low[1]
                for i = 1 to n
                    t := math.max(t, high[i])
                    b := math.min(b, low[i])
                if t > b
                    zt  := t
                    zb  := b
                    dem := bull
                    ok  := true
    [ok, zt, zb, dem]

// The 5m book must see EVERY 5m bar. request.security on a lower timeframe delivers only
// the last sub-bar of each chart bar, which silently drops two thirds of the 5m zones.
detOk() =>
    [o, t, b, d] = detect()
    o ? 1.0 : 0.0
detTop() =>
    [o, t, b, d] = detect()
    t
detBot() =>
    [o, t, b, d] = detect()
    b
detDem() =>
    [o, t, b, d] = detect()
    d ? 1.0 : 0.0

aOk  = request.security_lower_tf(syminfo.tickerid, tfA, detOk())
aTop = request.security_lower_tf(syminfo.tickerid, tfA, detTop())
aBot = request.security_lower_tf(syminfo.tickerid, tfA, detBot())
aDem = request.security_lower_tf(syminfo.tickerid, tfA, detDem())
[okC, tC, bC, dC] = request.security(syminfo.tickerid, tfC, detect(), lookahead=barmerge.lookahead_off)
[okD, tD, bD, dD] = request.security(syminfo.tickerid, tfD, detect(), lookahead=barmerge.lookahead_off)
// the entry timeframe is the chart timeframe, so detect it directly - no security round trip
[okB, tB, bB, dB] = detect()

newC = ta.change(time(tfC)) != 0
newD = ta.change(time(tfD)) != 0

// ─────────── 1h trend: trendLeg consecutive higher highs AND higher lows ───────────
trendCalc() =>
    float ph = ta.pivothigh(high, swingLR, swingLR)
    float pl = ta.pivotlow(low, swingLR, swingLR)
    var array<float> hs = array.new<float>()
    var array<float> ls = array.new<float>()
    if not na(ph)
        array.push(hs, ph)
        if array.size(hs) > 20
            array.shift(hs)
    if not na(pl)
        array.push(ls, pl)
        if array.size(ls) > 20
            array.shift(ls)
    int dir = 0
    if array.size(hs) > trendLeg and array.size(ls) > trendLeg
        bool up = true
        bool dn = true
        for k = 0 to trendLeg - 1
            float h1 = array.get(hs, array.size(hs) - 1 - k)
            float h0 = array.get(hs, array.size(hs) - 2 - k)
            float l1 = array.get(ls, array.size(ls) - 1 - k)
            float l0 = array.get(ls, array.size(ls) - 2 - k)
            if not (h1 > h0 and l1 > l0)
                up := false
            if not (h1 < h0 and l1 < l0)
                dn := false
        dir := up ? 1 : dn ? -1 : 0
    dir

trendStruct = request.security(syminfo.tickerid, trendTF, trendCalc(), lookahead=barmerge.lookahead_off)
htfC = request.security(syminfo.tickerid, trendTF, close[1], lookahead=barmerge.lookahead_off)
htfO = request.security(syminfo.tickerid, trendTF, open[1],  lookahead=barmerge.lookahead_off)
trendCandle = htfC > htfO ? 1 : htfC < htfO ? -1 : 0
trend = trendMode == "hh_hl" ? trendStruct : trendMode == "htf_candle" ? trendCandle : 0

// ─────────── confluence ───────────
// overlap, not containment; the other timeframe's zone must be the older one
hasOverlap(array<Zone> arr, float t, float b, bool dem, int bornAt) =>
    bool found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            Zone q = array.get(arr, i)
            if q.dem == dem and q.bot <= t and b <= q.top and q.born <= bornAt
                found := true
                break
    found

confluence(float t, float b, bool dem, int bornAt) =>
    int c = 0
    if hasOverlap(zA, t, b, dem, bornAt)
        c += 1
    if hasOverlap(zB, t, b, dem, bornAt)
        c += 1
    if hasOverlap(zC, t, b, dem, bornAt)
        c += 1
    if hasOverlap(zD, t, b, dem, bornAt)
        c += 1
    c


// Confluence is counted ONCE, when the zone is created, against every zone ever
// detected on the other timeframes - not against a pruned "still alive" book, and not
// re-counted later at the touch. Both of those starve the count to almost nothing.
confAt(float t, float b, bool dem) =>
    int c = 1
    if hasOverlap(zA, t, b, dem, bar_index)
        c += 1
    if hasOverlap(zC, t, b, dem, bar_index)
        c += 1
    if hasOverlap(zD, t, b, dem, bar_index)
        c += 1
    c

push(array<Zone> arr, bool ok, float t, float b, bool dem, int trendNow) =>
    if ok and not na(t) and not na(b)
        // keep the older of two overlapping same-direction zones on one timeframe,
        // otherwise a slow grind stacks near-identical zones and confluence is noise
        bool clash = false
        if array.size(arr) > 0
            for i = 0 to array.size(arr) - 1
                Zone q = array.get(arr, i)
                if q.dem == dem and q.bot <= t and b <= q.top
                    clash := true
                    break
        if not clash
            array.unshift(arr, Zone.new(t, b, dem, bar_index, false, trendNow, 0))
            if array.size(arr) > maxZones
                array.pop(arr)

if array.size(aOk) > 0
    for k = 0 to array.size(aOk) - 1
        if array.get(aOk, k) > 0.5
            push(zA, true, array.get(aTop, k), array.get(aBot, k), array.get(aDem, k) > 0.5, trend)
if newC
    push(zC, okC, tC, bC, dC, trend)
if newD
    push(zD, okD, tD, bD, dD, trend)
if okB and not na(tB) and not na(bB)
    int cfB = confAt(tB, bB, dB)
    if cfB >= needTF
        bool clashB = false
        if array.size(zB) > 0
            for i = 0 to array.size(zB) - 1
                Zone q = array.get(zB, i)
                if q.dem == dB and q.bot <= tB and bB <= q.top
                    clashB := true
                    break
        if not clashB
            array.unshift(zB, Zone.new(tB, bB, dB, bar_index, false, trend, cfB))
            if array.size(zB) > maxZones
                array.pop(zB)

// a zone dies when price closes clean through its distal edge
killThrough(array<Zone> arr) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            Zone z = array.get(arr, i)
            if bar_index > z.born and ((z.dem and close < z.bot) or (not z.dem and close > z.top))
                array.remove(arr, i)
killThrough(zB)

// ─────────── contract roll ───────────
isRollDay() =>
    int m = month(time)
    bool q = m == 3 or m == 6 or m == 9 or m == 12
    q and dayofmonth(time) >= 8 and dayofmonth(time) <= 15

// ─────────── rejection candle ───────────
rejects(bool long) =>
    float rng = high - low
    float bd  = bodyOf(open, close)
    float upW = high - math.max(open, close)
    float dnW = math.min(open, close) - low
    bool wick = long ? (rng > 0 and dnW >= 0.5 * rng and dnW >= 1.5 * bd)
                     : (rng > 0 and upW >= 0.5 * rng and upW >= 1.5 * bd)
    bool eng  = long ? (close > open and close[1] < open[1] and close >= open[1] and open <= close[1])
                     : (close < open and close[1] > open[1] and close <= open[1] and open >= close[1])
    bool brk  = long ? close > high[1] : close < low[1]
    wick or eng or brk

// Declared LAST on purpose. Pine numbers inputs by declaration order, so adding one
// anywhere above would silently renumber every saved input on the chart.
grpW = "Webhook"
sendAlerts    = input.bool(true, "Emit JSON alerts", group=grpW)
webhookSecret = input.string("", "Webhook secret", group=grpW)

var string sigId = na

rsiv  = ta.rsi(close, rsiLen)
atrCt = ta.atr(atrLen)

// ─────────── entry ───────────
// A zone arms on the bar AFTER it is registered. Without that the leg-out candle that
// creates the zone is itself still inside it, so every zone is consumed at birth.
if barstate.isconfirmed and strategy.position_size == 0 and not na(atrCt) and array.size(zB) > 0 and (not noRoll or not isRollDay())
    for i = 0 to array.size(zB) - 1
        Zone z = array.get(zB, i)
        if z.used or bar_index <= z.born
            continue
        float prox = z.dem ? z.top : z.bot
        float dist = z.dem ? z.bot : z.top
        bool touched = z.dem ? low <= prox : high >= prox
        if not touched
            continue
        z.used := true                      // consumed on first touch, entered or not
        int  tuse  = trendWhen == "touch" ? trend : z.tdir
        // "off" means take the zone's own direction and impose no trend condition
        bool dirOk = trendMode == "off" ? true : (z.dem ? tuse == 1 : tuse == -1)
        bool rsiOk = z.dem ? rsiv < rsiLongMax : rsiv > rsiShortMin
        if dirOk and rsiOk and rejects(z.dem)
            float w  = z.top - z.bot
            float sl = z.dem ? dist - w * slPct : dist + w * slPct
            float e  = close
            float r  = math.abs(e - sl)
            if r > 0 and (z.dem ? sl < e : sl > e)
                float tp = z.dem ? e + targetR * r : e - targetR * r
                if z.dem
                    strategy.entry("B-L", strategy.long)
                    strategy.exit("B-L x", "B-L", stop=sl, limit=tp)
                else
                    strategy.entry("B-S", strategy.short)
                    strategy.exit("B-S x", "B-S", stop=sl, limit=tp)
                if drawZones
                    box.new(z.born, z.top, bar_index, z.bot,
                         border_color = z.dem ? #089981 : #f23645,
                         bgcolor = z.dem ? color.new(#089981, 80) : color.new(#f23645, 80))
                // OPEN. The id is deterministic from symbol + bar time + side, so a
                // duplicate delivery is rejected by the backend rather than doubled.
                if sendAlerts
                    sigId := syminfo.ticker + "-" + str.tostring(time) + "-" + (z.dem ? "L" : "S")
                    alert('{"v":1,"secret":"' + webhookSecret + '"' +
                         ',"strategy":"continuation-b-v2"' +
                         ',"event":"OPEN"' +
                         ',"id":"' + sigId + '"' +
                         ',"symbol":"' + syminfo.ticker + '"' +
                         ',"side":"' + (z.dem ? "LONG" : "SHORT") + '"' +
                         ',"entry":' + str.tostring(e, "#.#####") +
                         ',"stop":' + str.tostring(sl, "#.#####") +
                         ',"target":' + str.tostring(tp, "#.#####") +
                         ',"atr":' + str.tostring(atrCt, "#.#####") +
                         ',"bar_time":' + str.tostring(time_close) + '}', alert.freq_once_per_bar_close)
            break


// ─────────── CLOSE ───────────
// strategy.closedtrades rises on the bar the bracket fills. Report the realised P&L so
// the backend can close its risk registry entry and advance equity.
if sendAlerts and ta.change(strategy.closedtrades) > 0 and not na(sigId)
    float pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    float exitPx = strategy.closedtrades.exit_price(strategy.closedtrades - 1)
    alert('{"v":1,"secret":"' + webhookSecret + '"' +
         ',"strategy":"continuation-b-v2"' +
         ',"event":"CLOSE"' +
         ',"signalId":"' + sigId + '"' +
         ',"symbol":"' + syminfo.ticker + '"' +
         ',"exit":' + str.tostring(exitPx, "#.#####") +
         ',"pnl":' + str.tostring(pnl, "#.##") +
         ',"bar_time":' + str.tostring(time_close) + '}', alert.freq_once_per_bar_close)
